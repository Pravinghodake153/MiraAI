# ==============================================================================
# VivaAI Production Environment Configuration
# ==============================================================================

# Server Port
PORT=3000

# OpenRouter Unified AI Key (Used for Mira Interviewer, STT, TTS & Rubric Evaluation)
# Get your API key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Primary Models
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_EVAL_MODEL=google/gemini-2.5-flash-lite

# Voice Engine Mode: 'web' (Browser Native, zero latency, free) or 'online' (OpenRouter cloud TTS/STT)
VOICE_ENGINE_MODE=web

# Institution Details
INSTITUTION_NAME="MSOT Autonomous Institute of Technology"
EXAM_EVENT="Technical Viva & Placement Examination 2026"
DEFAULT_EXAM_DURATION_MINUTES=15

# Clerk Authentication Configuration
# Create a free project at https://clerk.com and copy API keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
